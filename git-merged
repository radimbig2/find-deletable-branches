#!/usr/bin/env bash

# git-merged - Find Git branches that have been merged into a specified branch
# Usage: git-merged [branch-name] [options]

set -e

# Clear problematic Git environment variables that might be set by wrapper
unset GIT_DIR
unset GIT_WORK_TREE
unset GIT_CEILING_DIRECTORIES

# Default configuration
MAIN_BRANCH="main"
SEARCH_MODE="remote"
OUTPUT_FILE="deletable_branches_report.txt"
SAVE_TO_FILE=true
DELETE_REMOTE=false
DELETE_LOCAL=false
SKIP_CONFIRM=false
AUTHOR_FILTER=""

# Color codes for output
COLOR_CYAN='\033[0;36m'
COLOR_RED='\033[0;31m'
COLOR_YELLOW='\033[1;33m'
COLOR_RESET='\033[0m'

# Function to display help
show_help() {
    cat << EOF
git-merged - Find Git branches that have been merged into production

USAGE:
    git-merged [branch-name] [options]

ARGUMENTS:
    branch-name         Target branch to check merges into (default: main)

OPTIONS:
    -l, --local         Search local branches (default: remote)
    -r, --remote        Search remote branches
    -n, --no-file       Don't save to file, only display in console
    -o, --output PATH   Custom output file path
    --delete-remote     Delete found remote branches from origin
    --delete-local      Delete found local branches
    --skip-confirm      Delete without interactive confirmation
    --author NAME       Only include branches whose last commit author matches NAME
    -h, --help          Show this help message

EXAMPLES:
    # Find remote branches merged into origin/main
    git-merged

    # Find branches merged into production
    git-merged production

    # Find local branches merged into develop
    git-merged develop --local

    # Display only, don't save to file
    git-merged main --no-file

    # Save to custom location
    git-merged main --output ~/reports/merged-$(date +%Y%m%d).txt

    # Combined options
    git-merged production --local --output ./report.txt

    # Delete merged remote branches by author, with confirmation
    git-merged main --delete-remote --author radimbig

    # Delete merged local and remote branches without confirmation
    git-merged main --delete-local --delete-remote --skip-confirm

DESCRIPTION:
    This tool lists all branches that have been merged into the specified
    main branch. It displays the branch name, merge date, commit ID, and
    author. Results are grouped by author and sorted by merge date.

    The tool identifies branches through merge commits and excludes
    fast-forwarded or squashed branches.

REQUIREMENTS:
    - Git must be installed and available in PATH
    - Must be run from within a Git repository
    - For remote mode, requires access to origin remote

EOF
}

# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            show_help
            exit 0
            ;;
        -l|--local)
            SEARCH_MODE="local"
            shift
            ;;
        -r|--remote)
            SEARCH_MODE="remote"
            shift
            ;;
        -n|--no-file)
            SAVE_TO_FILE=false
            shift
            ;;
        -o|--output)
            if [[ -z "${2:-}" || "$2" == -* ]]; then
                echo -e "${COLOR_RED}Error: --output requires a path.${COLOR_RESET}" >&2
                exit 1
            fi
            OUTPUT_FILE="$2"
            shift 2
            ;;
        --delete-remote)
            DELETE_REMOTE=true
            shift
            ;;
        --delete-local)
            DELETE_LOCAL=true
            shift
            ;;
        --skip-confirm)
            SKIP_CONFIRM=true
            shift
            ;;
        --author)
            if [[ -z "${2:-}" || "$2" == -* ]]; then
                echo -e "${COLOR_RED}Error: --author requires a name.${COLOR_RESET}" >&2
                exit 1
            fi
            AUTHOR_FILTER="$2"
            shift 2
            ;;
        -*)
            echo -e "${COLOR_RED}Error: Unknown option $1${COLOR_RESET}" >&2
            echo "Use --help for usage information"
            exit 1
            ;;
        *)
            MAIN_BRANCH="$1"
            shift
            ;;
    esac
done

if [[ "$SKIP_CONFIRM" == true && "$DELETE_REMOTE" != true && "$DELETE_LOCAL" != true ]]; then
    echo -e "${COLOR_YELLOW}Warning: --skip-confirm has no effect without --delete-remote or --delete-local.${COLOR_RESET}" >&2
fi

# Check if we're in a git repository
if ! git rev-parse --is-inside-work-tree &>/dev/null; then
    echo -e "${COLOR_RED}Error: This is not a Git repository.${COLOR_RESET}" >&2
    exit 1
fi

# Temporary file to store branch data
TEMP_DATA=$(mktemp)
trap "rm -f $TEMP_DATA" EXIT

collect_merged_branches() {
    local mode="$1"
    local target_branch branch_list_cmd branch_prefix search_description

    if [[ "$mode" == "remote" ]]; then
        target_branch="origin/$MAIN_BRANCH"
        branch_list_cmd="git branch -r --merged $target_branch"
        branch_prefix="origin/"
        search_description="REMOTE branches (origin/*) merged into '$target_branch'"
    else
        target_branch="$MAIN_BRANCH"
        branch_list_cmd="git branch --merged $target_branch"
        branch_prefix=""
        search_description="LOCAL branches merged into '$target_branch'"
    fi

    echo "Searching for $search_description..."

    if [[ "$mode" == "remote" ]]; then
        git fetch --prune 2>/dev/null || true
    fi

    local merged_branches
    merged_branches=$(eval "$branch_list_cmd" 2>/dev/null | sed 's/^[ *]*//' || echo "")

    if [[ -z "$merged_branches" ]]; then
        return
    fi

    while IFS= read -r raw_branch; do
        if [[ "$raw_branch" == "$target_branch" ]] || [[ "$raw_branch" == *"HEAD ->"* ]]; then
            continue
        fi

        local display_branch="${raw_branch#$branch_prefix}"

        if [[ "$display_branch" == "$MAIN_BRANCH" ]]; then
            continue
        fi

        local tip_commit
        tip_commit=$(git rev-parse "$raw_branch" 2>/dev/null || echo "")
        if [[ -z "$tip_commit" ]]; then
            continue
        fi

        local author
        author=$(git log -1 --format="%an" "$raw_branch" 2>/dev/null || echo "Unknown")

        if [[ -n "$AUTHOR_FILTER" ]] && [[ "$author" != *"$AUTHOR_FILTER"* ]]; then
            continue
        fi

        local merge_commit
        merge_commit=$(git rev-list --merges --parents "$target_branch" 2>/dev/null | \
            awk -v tip="$tip_commit" '$3 == tip {print $1; exit}')

        if [[ -n "$merge_commit" ]]; then
            local merge_date commit_id
            merge_date=$(git show -s --format="%cI" "$merge_commit" 2>/dev/null)
            commit_id=$(git show -s --format="%h" "$merge_commit" 2>/dev/null)

            # Store data: mode|target|date|branch|commit|author|raw_branch
            echo "${mode}|${target_branch}|${merge_date}|${display_branch}|${commit_id}|${author}|${raw_branch}" >> "$TEMP_DATA"
        fi
    done <<< "$merged_branches"
}

if [[ "$DELETE_REMOTE" == true || "$DELETE_LOCAL" == true ]]; then
    [[ "$DELETE_REMOTE" == true ]] && collect_merged_branches "remote"
    [[ "$DELETE_LOCAL" == true ]] && collect_merged_branches "local"
else
    collect_merged_branches "$SEARCH_MODE"
fi

# Check if we found any data
if [[ ! -s "$TEMP_DATA" ]]; then
    echo "No merged branches found that match the criteria."
    exit 0
fi

# Prepare output
if [[ "$DELETE_REMOTE" == true && "$DELETE_LOCAL" == true ]]; then
    REPORT_HEADER="--- Branches Merged into target branch '$MAIN_BRANCH' (Modes: remote, local) ---"
elif [[ "$DELETE_REMOTE" == true ]]; then
    REPORT_HEADER="--- Branches Merged into 'origin/$MAIN_BRANCH' (Mode: remote) ---"
elif [[ "$DELETE_LOCAL" == true ]]; then
    REPORT_HEADER="--- Branches Merged into '$MAIN_BRANCH' (Mode: local) ---"
elif [[ "$SEARCH_MODE" == "remote" ]]; then
    REPORT_HEADER="--- Branches Merged into 'origin/$MAIN_BRANCH' (Mode: remote) ---"
else
    REPORT_HEADER="--- Branches Merged into '$MAIN_BRANCH' (Mode: local) ---"
fi
REPORT_DATE="Report generated on $(date '+%Y-%m-%d %H:%M:%S')"

# Function to format and display results
display_results() {
    echo ""
    echo "$REPORT_HEADER"
    echo "$REPORT_DATE"
    echo ""

    # Sort by author, then by date (descending)
    sort -t'|' -k6,6 -k3,3r "$TEMP_DATA" | \
    awk -F'|' '
    BEGIN {
        current_author = ""
        count = 0
    }
    {
        author = $6
        if (author != current_author) {
            if (current_author != "") {
                printf "\n"
            }
            current_author = author
            count = 0
            for (i = 1; i <= NF; i++) {
                if ($i == author) count++
            }
            printf "\033[0;36m=== Author: %s ===\033[0m\n", author
            printf "%-12s  %-50s  %s\n", "Merge Date", "Branch Name", "Commit ID"
            printf "%-12s  %-50s  %s\n", "----------", "------------------------------------", "---------"
        }
        
        # Extract date (YYYY-MM-DD)
        split($3, date_parts, "T")
        merge_date = date_parts[1]
        
        printf "%-12s  %-50s  %s\n", merge_date, $4, $5
    }
    END {
        printf "\n-----------------------------------------------------------\n"
    }'
}

# Display results to console
display_results

# Save to file if requested
if [[ "$SAVE_TO_FILE" == true ]]; then
    # Create output directory if needed
    OUTPUT_DIR=$(dirname "$OUTPUT_FILE")
    if [[ ! -d "$OUTPUT_DIR" ]]; then
        mkdir -p "$OUTPUT_DIR" 2>/dev/null || {
            echo -e "${COLOR_YELLOW}Warning: Could not create directory $OUTPUT_DIR${COLOR_RESET}" >&2
            echo "Results not saved to file."
            exit 0
        }
    fi

    # Save to file (without colors)
    {
        echo "$REPORT_HEADER"
        echo "$REPORT_DATE"
        echo ""
        
        sort -t'|' -k6,6 -k3,3r "$TEMP_DATA" | \
        awk -F'|' '
        BEGIN {
            current_author = ""
        }
        {
            author = $6
            if (author != current_author) {
                if (current_author != "") {
                    printf "\n"
                }
                current_author = author
                printf "=== Author: %s ===\n", author
                printf "%-12s  %-50s  %s\n", "Merge Date", "Branch Name", "Commit ID"
                printf "%-12s  %-50s  %s\n", "----------", "------------------------------------", "---------"
            }
            
            split($3, date_parts, "T")
            merge_date = date_parts[1]
            
            printf "%-12s  %-50s  %s\n", merge_date, $4, $5
        }
        END {
            printf "\n-----------------------------------------------------------\n"
        }'
    } > "$OUTPUT_FILE"
    
    echo ""
    echo "Report saved to '$OUTPUT_FILE'"
fi

run_delete_commands() {
    local commands_file
    commands_file=$(mktemp)
    local branches_file
    branches_file=$(mktemp)
    trap "rm -f $TEMP_DATA $commands_file $branches_file" EXIT

    while IFS='|' read -r mode target_branch merge_date branch_name commit_id author raw_branch; do
        local merge_day="${merge_date%%T*}"
        if [[ "$merge_day" =~ ^([0-9]{4})-([0-9]{2})-([0-9]{2})$ ]]; then
            merge_day="${BASH_REMATCH[3]}.${BASH_REMATCH[2]}.${BASH_REMATCH[1]}"
        fi

        if [[ "$mode" == "remote" ]]; then
            printf "%s merged %s into %s\n" "$branch_name" "$merge_day" "$target_branch" >> "$branches_file"
            printf "git push origin --delete %q\n" "$branch_name" >> "$commands_file"
        elif [[ "$mode" == "local" ]]; then
            printf "%s merged %s into %s\n" "$branch_name" "$merge_day" "$target_branch" >> "$branches_file"
            printf "git branch -d %q\n" "$branch_name" >> "$commands_file"
        fi
    done < "$TEMP_DATA"

    if [[ ! -s "$commands_file" ]]; then
        return
    fi

    if [[ "$SKIP_CONFIRM" != true ]]; then
        echo ""
        echo "confirm deleting:"
        cat "$branches_file"
        echo ""
        echo "commands that will be executed"
        cat "$commands_file"
        echo ""
        read -r -p "Proceed with deleting these branches? [y/N] " confirmation || confirmation=""
        if [[ "$confirmation" != "y" && "$confirmation" != "Y" && "$confirmation" != "yes" && "$confirmation" != "YES" ]]; then
            echo "Deletion cancelled."
            return
        fi
    else
        echo ""
        echo "commands that will be executed"
        cat "$commands_file"
    fi

    while IFS= read -r command_to_run; do
        echo ""
        echo "+ $command_to_run"
        eval "$command_to_run"
    done < "$commands_file"
}

if [[ "$DELETE_REMOTE" == true || "$DELETE_LOCAL" == true ]]; then
    run_delete_commands
fi
